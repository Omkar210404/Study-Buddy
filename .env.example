# Copy to .env and edit. Never commit .env.

# Where the SQLite database lives. The data/ folder is git-ignored.
DATABASE_PATH=data/studybuddy.db

# Card generation by a language model is optional.
#   none               offline mode only. Nothing leaves this computer. (default)
#   openai_compatible  any OpenAI-compatible Chat Completions API. The passages you generate
#                      cards from are sent to LLM_BASE_URL. Nothing else is sent.
#   mock               a deterministic fake model for demos and tests. No network.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Examples:
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=<a model from your Groq console>
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<provider/model>
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=<local model>  LLM_API_KEY=ollama

# Limits for one LLM generation run (kept small for free tiers).
LLM_MAX_PASSAGES_PER_RUN=20
LLM_CARDS_PER_PASSAGE=3

# Only used when LLM_PROVIDER=mock: good | fake_quotes | mixed | invalid_json
MOCK_LLM_MODE=good

# Review settings
NEW_CARDS_PER_DAY=20
MAX_UPLOAD_MB=5
